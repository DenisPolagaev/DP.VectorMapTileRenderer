<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props defaults TargetFramework to net11.0; clearing it lets the outer build iterate TargetFrameworks. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DP.VectorMapTileRenderer.GeoJson</RootNamespace>
    <AssemblyName>DP.VectorMapTileRenderer.GeoJson</AssemblyName>
    <Description>GeoJSON tile source (NetTopologySuite) for DP.VectorMapTileRenderer.</Description>
    <PackageTags>GeoJSON;VectorTile;MapLibre;NetTopologySuite</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DP.VectorMapTileRenderer\DP.VectorMapTileRenderer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" />
  </ItemGroup>

</Project>
