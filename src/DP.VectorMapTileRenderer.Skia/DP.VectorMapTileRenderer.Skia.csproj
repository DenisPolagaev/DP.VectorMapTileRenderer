<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props defaults TargetFramework to net11.0; clearing it lets the outer build iterate TargetFrameworks. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DP.VectorMapTileRenderer</RootNamespace>
    <AssemblyName>DP.VectorMapTileRenderer.Skia</AssemblyName>
    <Description>SkiaSharp renderer (style engine output, canvas, PNG cache) for DP.VectorMapTileRenderer.</Description>
    <PackageTags>VectorTile;MapLibre;SkiaSharp;Rendering</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DP.VectorMapTileRenderer\DP.VectorMapTileRenderer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DP.VectorMapTileRenderer.Tests" />
  </ItemGroup>

</Project>
