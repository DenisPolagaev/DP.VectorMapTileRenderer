<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props defaults TargetFramework to net11.0; clearing it lets the outer build iterate TargetFrameworks. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DP.VectorMapTileRenderer.Pmtiles</RootNamespace>
    <AssemblyName>DP.VectorMapTileRenderer.Pmtiles</AssemblyName>
    <Description>PMTiles v3 tile source (MVT/MLT/raster) for DP.VectorMapTileRenderer.</Description>
    <PackageTags>PMTiles;VectorTile;MapLibre;MVT;MLT</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DP.VectorMapTileRenderer\DP.VectorMapTileRenderer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

</Project>
